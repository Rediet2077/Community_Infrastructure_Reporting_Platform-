# ============================================================
# CIRP — Community Infrastructure Reporting Platform
# .gitignore — root (covers backend, frontend, mobile, ai)
# ============================================================

# ── Python / Django ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*.coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── Django migrations (keep them — do NOT ignore) ──────────
# backend/apps/*/migrations/*.py  <-- do NOT add this

# ── Node / React ───────────────────────────────────────────
node_modules/
dist/
build/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
coverage/

# ── Flutter / Dart ─────────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/android/.gradle
mobile/android/local.properties
mobile/android/key.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
*.iml
*.class

# ── AI / ML ────────────────────────────────────────────────
ai/datasets/raw/
ai/datasets/processed/
ai/models/saved/*.pt
ai/models/saved/*.pth
ai/models/saved/*.h5
ai/models/saved/*.keras
ai/**/__pycache__/
ai/.venv/
ai/venv/
*.pkl
*.joblib
mlruns/
wandb/
.neptune/

# ── Secrets / Credentials ──────────────────────────────────
.env
.env.*
!.env.example
secrets.json
credentials.json
serviceAccountKey.json
*.pem
*.key
*.p12

# ── IDE / OS ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

